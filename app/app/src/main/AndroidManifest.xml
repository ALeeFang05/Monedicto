<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <!-- Permite internet -->
    <uses-permission
        android:name="android.permission.INTERNET" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Monedicto"
        tools:targetApi="m">

        <!-- Pantalla de Inicio por defecto (Login) -->
        <activity
            android:name=".LoginAct"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tu Dashboard u otras pantallas se quedan registradas aca -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".RegistroAct"
            android:exported="false" />
        <activity
            android:name=".FinanzasAct"
            android:exported="false" />
        <activity
            android:name=".EncuestaAct"
            android:exported="false" />
        <activity
            android:name=".BloqueosAct"
            android:exported="false" />

        <service
            android:name=".BloqueoAppsService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/config_accesibilidad" />
        </service>
    </application>

</manifest>