<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Monedicto"
        tools:targetApi="m">

        <!-- Permite internet -->
        <uses-permission
            android:name="android.permission.INTERNET" />

        <!-- Pantalla de Inicio por defecto (Login) -->
        <activity
            android:name=".LoginAct"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tu Dashboard u otras pantallas se quedan registradas aca -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".RegistroAct"
            android:exported="false" />
        <activity
            android:name=".FinanzasAct"
            android:exported="false" />
        <activity
            android:name=".EncuestaAct"
            android:exported="false" />
    </application>

</manifest>