<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/fondo_frio">

    <!-- 1. BARRA SUPERIOR (Toolbar) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/verde_primario"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="@color/blanco"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón de la M: Solo aparecerá cuando el NavigationRail se oculte -->
        <Button
            android:id="@+id/btnMenuToolbar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="M"
            android:textStyle="bold"
            android:textSize="18sp"
            android:backgroundTint="@color/verde_secundario"
            android:textColor="@color/blanco"
            android:visibility="gone"
            tools:visibility="visible"/>

    </androidx.appcompat.widget.Toolbar>

    <!-- 2. BARRA LATERAL IZQUIERDA (Navigation Rail) -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navigationRail"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@color/blanco"
        app:headerLayout="@layout/rail_header"
        app:menu="@menu/menu_rail_iconos"
        app:itemIconTint="@color/verde_primario"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.NavigationRailView.ActiveIndicator"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 3. CONTENIDO CENTRAL (Dashboard) -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/navigationRail"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Bienvenido de vuelta!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu resumen financiero y bienestar"
                android:textSize="14sp"
                android:textColor="@color/texto_gris_frio"
                android:layout_marginBottom="20dp"/>

            <!-- TARJETA 1: Meta General de Ahorro -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/blanco"
                app:strokeColor="#DCE6E8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meta General de Ahorro"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_primario" />

                    <!-- Barra de progreso en tonos verdes -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progresoAhorro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="14dp"
                        app:trackThickness="10dp"
                        app:trackCornerRadius="5dp"
                        android:max="100"
                        android:progress="0"
                        app:trackColor="@color/verde_suave_fondo"
                        app:indicatorColor="@color/verde_primario" />

                    <!-- Fila informativa de balances -->
                    <TextView
                        android:id="@+id/txtMontoAhorrado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_oscuro"/>

                    <TextView
                        android:id="@+id/txtMetaAhorro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Meta: $0.00"
                        android:textSize="13sp"
                        android:textColor="@color/texto_gris_frio"
                        android:layout_marginBottom="14dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EDF2F4"
                        android:layout_marginBottom="14dp"/>

                    <!-- BLOQUE DE FECHAS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fecha Inicio"
                                android:textSize="11sp"
                                android:textColor="@color/texto_gris_frio"/>
                            <TextView
                                android:id="@+id/txtFechaInicio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- / -- / ----"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/texto_oscuro"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fecha Límite"
                                android:textSize="11sp"
                                android:textColor="@color/texto_gris_frio"/>
                            <TextView
                                android:id="@+id/txtFechaFin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- / -- / ----"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/texto_oscuro"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 2: Último Diagnóstico SOGS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/verde_suave_fondo"
                app:strokeColor="@color/verde_secundario"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Último Diagnóstico SOGS"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_primario"
                        android:layout_marginBottom="8dp" />

                    <!-- Muestra los puntos (Ej: 4 / 13 Puntos) -->
                    <TextView
                        android:id="@+id/txtResultadoSogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 / 13 Puntos"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_oscuro" />

                    <!-- Muestra la clasificación clínica (Ej: Juego de Riesgo) -->
                    <TextView
                        android:id="@+id/txtClasificacionSogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sin evaluaciones"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_primario"
                        android:layout_marginBottom="4dp" />

                    <!-- Muestra el número total de encuestas realizadas -->
                    <TextView
                        android:id="@+id/txtTotalEncuestas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Evaluaciones hechas: 0"
                        android:textSize="12sp"
                        android:textColor="@color/texto_gris_frio"
                        android:layout_marginBottom="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CDE3DF"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Última reflexión guardada:"
                        android:textSize="11sp"
                        android:textColor="@color/texto_gris_frio"
                        android:layout_marginBottom="4dp" />

                    <!-- Caja para el texto de auto-reflexión larga -->
                    <TextView
                        android:id="@+id/txtUltimaReflexion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="&quot;No hay reflexiones registradas todavía.&quot;"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:textColor="@color/texto_oscuro"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>