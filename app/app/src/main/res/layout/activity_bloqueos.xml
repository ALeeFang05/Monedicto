<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_frio"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bloqueos y Protección"
        android:textColor="@color/verde_primario"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Controla el acceso a plataformas de juego"
        android:textColor="@color/texto_gris_frio"
        android:textSize="14sp" />

    <!-- Tarjeta 1: Bloqueo de Apps -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/blanco"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="#DCE6E8"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bloqueo de Apps"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cierra automáticamente las apps marcadas"
                    android:textColor="@color/texto_gris_frio"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBloqueoApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/verde_primario"
                app:trackTint="@color/verde_suave_fondo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tarjeta 2: Filtro Web y DNS -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/blanco"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="#DCE6E8"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filtro Web y DNS Seguro"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restringe sitios de apuestas en navegadores"
                    android:textColor="@color/texto_gris_frio"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBloqueoDns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/verde_primario"
                app:trackTint="@color/verde_suave_fondo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Selecciona las aplicaciones a restringir:"
        android:textColor="@color/texto_oscuro"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Tarjeta contenedora de la lista con iconos -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/blanco"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="#DCE6E8"
        app:strokeWidth="1dp">

        <ListView
            android:id="@+id/listaAppsInstaladas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#EDF2F4"
            android:dividerHeight="1dp" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>