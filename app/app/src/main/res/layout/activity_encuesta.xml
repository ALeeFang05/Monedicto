                    android:text="13. Si has pedido prestado dinero para jugar o pagar deudas, ¿a quién se lo has pedido o de dónde lo has obtenido? (Dinero de casa, pareja, familiares, bancos, tarjetas de crédito, prestamistas o venta de propiedades)." />

                <RadioGroup
                    android:id="@+id/rbGB13"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb13_S"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/verde_primario"
                        android:text="Sí"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rb13_N"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/verde_primario"
                        android:text="No"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="15sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA: BITÁCORA DE AUTO-REFLEXIÓN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/verde_suave_fondo"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/verde_secundario"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Bitácora de auto-reflexión:"
                    android:textColor="@color/verde_primario"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/verde_primario"
                    app:hintTextColor="@color/verde_primario">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editComentarios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="¿Cómo te sientes hoy respecto al juego o tus metas?"
                        android:inputType="textLongMessage|textMultiLine"
                        android:lines="3"
                        android:textColor="@color/texto_oscuro" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 🚀 BOTÓN DE ACCIÓN PARA MANDAR A KTOR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/verde_primario"
            android:text="Enviar Evaluación SOGS"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>