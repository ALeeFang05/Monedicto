<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAF7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar nuevo Ahorro"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="20dp" />

        <!-- 💳 NUEVA TARJETA DE PROGRESO INTEGRAL (Sincronizada con el Dashboard) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#EDE7F6"> <!-- Mantiene tu tono morado de fondo -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado Actual de tu Meta"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#6C4AB6" />

                <!-- Muestra el balance general acumulado -->
                <TextView
                    android:id="@+id/txtTotalAhorrado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#6C4AB6"
                    android:layout_marginTop="5dp" />

                <!-- Barra informativa con meta simulada -->
                <TextView
                    android:id="@+id/txtInfoMetas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculando meta estimada..."
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:layout_marginTop="2dp"/>

                <!-- Divisor intermedio -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1C4E9"
                    android:layout_marginVertical="12dp"/>

                <!-- BLOQUE DE FECHAS DINÁMICAS (Lado a lado) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inicio estimado"
                            android:textSize="11sp"
                            android:textColor="#666666"/>
                        <TextView
                            android:id="@+id/txtFechaInicioAhorro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- / -- / ----"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#222222"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fin estimado"
                            android:textSize="11sp"
                            android:textColor="#666666"/>
                        <TextView
                            android:id="@+id/txtFechaFinAhorro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- / -- / ----"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#222222"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ✍️ SECCIÓN DE ENTRADA: CONCEPTO -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#6C4AB6"
            app:hintTextColor="#6C4AB6">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editConcepto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Concepto u Objetivo"
                android:inputType="text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 💰 SECCIÓN DE ENTRADA: MONTO -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#6C4AB6"
            app:hintTextColor="#6C4AB6"
            app:prefixText="$ ">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editMonto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Monto a guardar"
                android:inputType="numberDecimal"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ⏱️ SECCIÓN DE ENTRADA: TIEMPO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cuánto tiempo deseas guardar tu dinero?"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#6C4AB6"
            app:hintTextColor="#6C4AB6">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTiempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cantidad de tiempo"
                android:inputType="number"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 📅 MESES O AÑOS -->
        <RadioGroup
            android:id="@+id/radioPeriodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="25dp">

            <RadioButton
                android:id="@+id/radioMeses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meses"
                android:checked="true"
                android:buttonTint="#6C4AB6"
                android:layout_marginEnd="30dp" />

            <RadioButton
                android:id="@+id/radioAnios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#6C4AB6"
                android:text="Años" />
        </RadioGroup>

        <!-- 🚀 BOTÓN DE ACCIÓN -->
        <Button
            android:id="@+id/btnGuardarAhorro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Confirmar Depósito"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="#6C4AB6" />
    </LinearLayout>
</ScrollView>
