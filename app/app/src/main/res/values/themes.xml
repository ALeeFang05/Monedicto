<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de Monedicto con tonos fríos y verde -->
    <style name="Base.Theme.Monedicto" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores principales de marca -->
        <item name="colorPrimary">@color/verde_primario</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/verde_suave_fondo</item>
        <item name="colorOnPrimaryContainer">@color/verde_primario</item>

        <!-- Colores secundarios y acentos -->
        <item name="colorSecondary">@color/verde_secundario</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="colorSecondaryContainer">@color/verde_suave_fondo</item>
        <item name="colorOnSecondaryContainer">@color/texto_oscuro</item>

        <!-- Color de fondo general y de la barra de estado superior -->
        <item name="android:windowBackground">@color/fondo_frio</item>
        <item name="android:statusBarColor">@color/verde_primario</item>
    </style>

    <style name="Theme.Monedicto" parent="Base.Theme.Monedicto" />
</resources>